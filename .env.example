# Gemini AI keys are per-user, set by each account in Paramètres (stored
# encrypted in api_settings). There is no platform-wide Gemini key — every AI
# call goes through POST /api/ai/generate and uses the signed-in user's own key.

# DATABASE_URL: PostgreSQL connection string (Neon, Supabase, or local).
# Get from your database dashboard. Used by Prisma for all data persistence.
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google-only login. Both are REQUIRED for real Google OAuth; when they are
# missing, the login button runs a clearly-labeled DEV MOCK instead (testable).
# Create credentials at https://console.cloud.google.com/apis/credentials
# and set the OAuth redirect URI to {APP_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SESSION_SECRET: signs the login cookie. Must be a long random string.
# In development it falls back to a dev default; in production it is required.
SESSION_SECRET=

# Optional — both fall back to SESSION_SECRET when unset:
#   OTP_HASH_SECRET        keys OTP hashes (HMAC) so DB dumps can't be offline-brute-forced.
#   TOKEN_ENCRYPTION_KEY   encrypts ad-platform tokens at rest (AES-256-GCM).
# Rotate these independently from SESSION_SECRET for defense in depth.
OTP_HASH_SECRET=
TOKEN_ENCRYPTION_KEY=

# Email OTP delivery (6-digit verification codes). Provider resolution:
#   1. RESEND_API_KEY  → send via the Resend HTTP API (https://resend.com).
#   2. SMTP_* set      → send via nodemailer (SMTP_HOST required).
#   3. neither         → CONSOLE mode: the code is logged to the server
#      console so the flow is fully testable with no email account.
# The verify page shows a "dev mode" hint automatically in that case.
RESEND_API_KEY=
EMAIL_FROM="DzAds AI <no-reply@dzads.ai>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Manual payment confirmation: where the buyer sends the facture proof, and the
# token the admin uses to confirm a plan (POST /api/admin/confirm-plan).
ADMIN_EMAIL="admin@dzads.ai"
ADMIN_TELEGRAM="DzAdsAdmin"
ADMIN_TOKEN=

# Real Telegram product scouting (MTProto). All three are REQUIRED for live reads;
# without them /api/telegram-trends returns a clearly-labeled simulation.
# - TELEGRAM_API_ID / TELEGRAM_API_HASH: your MTProto app credentials (my.telegram.org)
# - TELEGRAM_SESSION: a StringSession string from a previously authorized account
#   (generate it once via a local script using the `telegram` package).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Public address of the site (used for link-preview images in WhatsApp/Facebook). Example: https://ecomflow.example
SITE_URL=

# Meta (Facebook & Instagram) campaign publishing. Optional: without these, the app says direct publishing is not
# set up yet and sellers export their ads by hand. Create a Business app at https://developers.facebook.com/apps with
# Facebook Login (or Facebook Login for Business) and the Marketing API, and add {SITE_URL}/api/meta/callback to its
# valid OAuth redirect URIs. The app secret never leaves the server; sellers' Meta tokens are stored encrypted
# (TOKEN_ENCRYPTION_KEY). See README.md, "Meta publishing", for the review Meta requires before going public.
META_APP_ID=
META_APP_SECRET=
# Defaults to {SITE_URL}/api/meta/callback
META_REDIRECT_URI=
# Graph API version (default v26.0), and the configuration id when using Facebook Login for Business
META_GRAPH_VERSION=
META_LOGIN_CONFIG_ID=

# Number of proxies in front of the server (default 1: Vercel's edge, or nginx/LiteSpeed on a Node host). The app
# trusts exactly that many hops when reading the client address for its rate limits; 0 if it faces the internet.
TRUST_PROXY=
